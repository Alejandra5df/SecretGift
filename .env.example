# ============ SecretGift API ============
# Copia este archivo como ".env" y llena tus datos.

PORT=3000
NODE_ENV=development

# ---- Base de datos MySQL ----
# Local:  127.0.0.1 / root / secretgift   (DB_SSL=false)
# Aiven for MySQL (nube): copia host, puerto, usuario, contraseña y nombre desde la consola de Aiven
#   DB_HOST=mysql-xxxx-tuproyecto.a.aivencloud.com
#   DB_PORT=12345
#   DB_USER=avnadmin
#   DB_NAME=defaultdb
#   DB_SSL=true
#   DB_SSL_CA=   (opcional: contenido del "CA certificate" de Aiven; si va en una línea, usa \n entre líneas)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=secretgift
DB_SSL=false
DB_SSL_CA=

# ---- Seguridad ----
# Cadena larga y aleatoria (mínimo 32 caracteres). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRA=7d

# ---- Correo (código de verificación) ----
# Ejemplo con Gmail (necesita verificación en 2 pasos y una "contraseña de aplicación"):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=
SMTP_FROM="SecretGift <tucorreo@gmail.com>"
# Si dejas SMTP_USER o SMTP_PASS vacíos, en desarrollo el código se imprime en la
# terminal del servidor (no se envía correo). En producción es obligatorio configurarlo.

# ---- Gmail API (opción para Render GRATIS, donde el SMTP está bloqueado) ----
# Si llenas las tres, el correo sale por HTTPS desde tu Gmail y se ignora el SMTP de arriba.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ---- reCAPTCHA v2 ("No soy un robot"), solo en el inicio de sesión ----
# Crea las claves en https://www.google.com/recaptcha/admin (tipo v2 casilla) y agrega los dominios:
# tu dominio de Render (xxxx.onrender.com), localhost y 127.0.0.1.
# La clave SECRETA va aquí; la clave del SITIO va en la app (src/app/config.ts).
RECAPTCHA_SECRET=

# ---- Firebase Cloud Messaging (notificaciones push) ----
# Firebase Console > Configuración del proyecto > Cuentas de servicio > "Generar nueva clave privada".
# Pega el JSON completo en UNA línea, o conviértelo a base64:  base64 -w0 cuenta.json
FIREBASE_SERVICE_ACCOUNT=

# ---- Link de invitación ----
# Dirección pública de tu servidor (la que va en los links). En Render es algo como
# https://secretgift-api.onrender.com  (node configurar-android.js la escribe por ti)
APP_URL=http://localhost:3000

# ---- App Android (links que abren la app directo) ----
# node configurar-android.js los llena solos.
ANDROID_APP_ID=
ANDROID_SHA256=

# ---- CORS (orígenes extra permitidos, separados por coma) ----
# En desarrollo ya se permiten localhost y tu red local. En producción pon aquí
# la dirección de tu app web, por ejemplo: https://miapp.com
CORS_ORIGINS=
